 ],
 "harness": {
  "name": "awharness",
  "tagline": "The super agent harness",
  "status": "partial",
  "entry_point": "adk harness parts",
  "what": "One name for the kit, the shell and the bricks an agent works with, taken together. It is a harness that sits above other harnesses: the shell drives Claude Code, Codex and the rest as real products, and the bricks give every one of them the same memory, jobs, leases, permits and tools.",
  "today": "There is no single install. `pip install awdk` and `npm i -g @aitherium/awsh` are two commands, and each other brick installs on its own line. `adk harness parts` reads this list and reports which parts this machine has, at what version, and the install line for each one it lacks.",
  "planned": "One install command that brings the composed bricks up together, and one process that starts them. Neither exists; nothing by this name is published.",
  "composes": [
   "awdk",
   "awsh",
   "awskills",
   "awm",
   "awgraph",
   "awrun",
   "awrise",
   "awgit",
   "awpermit",
   "awrelay",
   "awnode"
  ]
 }
}
